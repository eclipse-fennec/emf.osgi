<?xml version="1.0" encoding="UTF-8"?>
<genmodel:GenModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:genmodel="http://www.eclipse.org/emf/2002/GenModel" modelDirectory="/org.fennec.test.multi.model/src-gen"
    modelPluginID="org.fennec.test.multi.model" modelName="Multi" rootExtendsClass="org.eclipse.emf.ecore.impl.MinimalEObjectImpl$Container"
    importerID="org.eclipse.emf.importer.ecore" bundleManifest="false" complianceLevel="8.0"
    copyrightFields="false" usedGenPackages="../../../../../org.eclipse.emf.ecore/model/Ecore.genmodel#//ecore"
    operationReflection="true" importOrganizing="true">
  <foreignModel>a.ecore</foreignModel>
  <foreignModel>b.ecore</foreignModel>
  <genPackages prefix="Packa" basePackage="org.fennec.test.multi" disposableProviderFactory="true"
      ecorePackage="a.ecore#/">
    <genClasses ecoreClass="a.ecore#//AObject">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute a.ecore#//AObject/name"/>
    </genClasses>
  </genPackages>
  <genPackages prefix="Packb" basePackage="org.fennec.test.multi" disposableProviderFactory="true"
      ecorePackage="b.ecore#/">
