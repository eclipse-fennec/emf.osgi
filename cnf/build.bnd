-require-bnd: "(version>=7.2.0)"

-library: \
 	fennecTest,\
 	fennec

github-project: emf.osgi
github-orga: eclipse-fennec

maven-central: true

#-baseline: *

-groupid: org.eclipse.fennec.emf
    	
-plugin.3.Central: \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        snapshotUrl=https://central.sonatype.com/repository/maven-snapshots/; \
        releaseUrl=https://repo.maven.apache.org/maven2/; \
        index=${.}/central.mvn; \
        readOnly=true; \
        poll.time=-1; \
        name="Central"

-plugin: aQute.bnd.deployer.repository.LocalIndexedRepo;\
		local               =${.}/local;\
		overwrite           =true;\
		pretty              =true;\
		name            	=local

# Release OBR (cnf/release). '-releaserepo.obr' is a merged property, so it
# survives the fennec library's '-releaserepo: Sonatype' override and the
# single release run publishes the identical bundles to Maven Central AND
# this OBR. The release workflow pushes cnf/release to the 'release-obr'
# branch, where it serves as the baseline repository.
# TODO: migrate to the fennec library once proven here.
-plugin.release: \
	aQute.bnd.deployer.repository.LocalIndexedRepo;\
		local               =${build}/release;\
		overwrite           =true;\
		pretty              =true;\
		name            	=Release

# Only added for actual releases (DO_RELEASE=true, i.e. the release build on
# main) — snapshot builds don't populate the OBR. Note: in the release build
# the Sonatype repo is active, so the merged result is 'Sonatype, Release'.
# A local DO_RELEASE=true run without the GPG secrets would merge
# 'Release, Release' and fail on the duplicate name.
-releaserepo.obr: ${if;${env;DO_RELEASE;false};Release}

# Baselining against the last release OBR — enable after the 1.0.0 release
# has published the first release-obr branch.
#-plugin.baseline: \
#	aQute.bnd.repository.osgi.OSGiRepository;\
#		locations           =https://raw.githubusercontent.com/${github-orga}/${github-project}/release-obr/index.xml;\
#		max.stale           =-1;\
#		poll.time           =-1;\
#		name                =Baseline
#-baselinerepo: Baseline
#-baseline: *
		
-plugin.2.DIM: \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        snapshotUrl=https://devel.data-in-motion.biz/nexus/repository/dim-snapshot/; \
        releaseUrl=https://devel.data-in-motion.biz/nexus/repository/maven-releases/; \
        index=${.}/dim-uml.mvn; \
        readOnly=true; \
        poll.time=-1; \
        name="DIM UML2"
        
-plugin.emf: \
	aQute.bnd.repository.maven.provider.MavenBndRepository;\
		releaseUrl			= "https://repo.eclipse.org/content/repositories/emf-snapshots/";\
		snapshotUrl			= "https://repo.eclipse.org/content/repositories/emf-snapshots/";\
		index               = ${.}/eclipse_emf.maven;\
		transitive          = false;\
		readOnly            = true;\
		name                = "EMF Milestone Dependendencies"
	