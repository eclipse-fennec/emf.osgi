Bundle-Name: Eclipse Fennec EMF OSGi Metadata
Bundle-Description: Pre-computed metadata mirror tree for EPackages - model, API and service

src=${^src},src-gen

# org.eclipse.fennec.emf.osgi is on the -buildpath for the non-OSGi bootstrap only:
# MetadataServices.createWhiteboard(MetadataHandler...) reads the default FingerprintService
# from FingerprintHelper. That package is exported by both sub-bundles, so the resulting
# Import-Package resolves against either of them - no manifest negation needed. No cycle:
# that project builds against ...osgi.api only and references nothing from here.
-buildpath: \
	org.eclipse.fennec.emf.osgi.api;version=snapshot,\
	org.eclipse.fennec.emf.osgi;version=project,\
	org.eclipse.emf.ecore;version=latest,\
	org.eclipse.emf.common;version=latest,\
	org.eclipse.emf.ecore.xmi;version=latest,\
	org.osgi.annotation.bundle;version=latest,\
	org.osgi.annotation.versioning;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.condition;version=latest,\
	org.osgi.framework;version=latest

# No -privatepackage / Export-Package here on purpose: bnd includes every source
# package by default, and the @Export annotations on the API and generated model
# package-infos decide what leaves the bundle. Listing the impl package explicitly
# would restrict the bundle to exactly that package and silently drop API and model.
-testpath: \
	${junit}

-includeresource.model: model=model

-dependson: org.eclipse.fennec.emf.osgi.codegen

-generate:\
	model/metadata.genmodel;\
		generate="fennecEMF";\
		genmodel=model/metadata.genmodel;\
		output=src-gen;\
		version=${base-version};\
		clean=false;\
		logfile=out.log
