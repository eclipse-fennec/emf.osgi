Bundle-Name: Eclipse Fennec EMF OSGi Metadata
Bundle-Description: Pre-computed metadata mirror tree for EPackages - model, API and service

src=${^src},src-gen

-buildpath: \
	org.eclipse.fennec.emf.osgi.api;version=snapshot,\
	org.eclipse.emf.ecore;version=latest,\
	org.eclipse.emf.common;version=latest,\
	org.eclipse.emf.ecore.xmi;version=latest,\
	org.osgi.annotation.bundle;version=latest,\
	org.osgi.annotation.versioning;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.condition;version=latest,\
	org.osgi.framework;version=latest

-testpath: ${junit}

-includeresource.model: model=model

-dependson: org.eclipse.fennec.emf.osgi.codegen

-generate:\
	model/metadata.genmodel;\
		generate="fennecEMF";\
		genmodel=model/metadata.genmodel;\
		output=src-gen;\
		version=${base-version};\
		clean=false;\
		logfile=out.log
