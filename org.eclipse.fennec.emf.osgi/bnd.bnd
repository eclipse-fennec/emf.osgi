-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.annotation.bundle;version=latest,\
	org.osgi.annotation.versioning;version=latest,\
	org.osgi.namespace.service;version=latest,\
	org.osgi.namespace.extender;version=latest,\
	org.osgi.namespace.implementation;version=latest,\
	org.osgi.resource;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.condition;version=latest,\
	org.osgi.util.converter;version=latest,\
	biz.aQute.bnd.annotation;version=latest,\
	org.eclipse.emf.common;version=latest,\
	org.eclipse.emf.ecore;version=latest,\
	org.eclipse.emf.ecore.xmi;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.eclipse.fennec.emf.osgi.api;version=snapshot
	
# Add proper JPMS module-info
-jpms-module-info:	

-sub: *.bnd
-testpath: ${junit}

# The parentRegistry reference of ConfigurationEPackageRegistryComponent moved into the
# constructor (#106), which drops its bind methods. Baselining reports that as a MAJOR change
# of org.eclipse.fennec.emf.osgi.components.config, but the class is a DS component that only
# SCR instantiates, so nothing changes for a consumer of the package. Reviewed and deliberately
# kept at 1.1, see https://github.com/eclipse-fennec/emf.osgi/pull/106.
-fixupmessages: \
	"*Baseline mismatch for package org.eclipse.fennec.emf.osgi.components.config*";restrict:=error;is:=ignore,\
	"*The bundle version*is too low, must be at least 2.0.0*";restrict:=error;is:=ignore
