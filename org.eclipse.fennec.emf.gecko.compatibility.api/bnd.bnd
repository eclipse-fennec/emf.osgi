-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.annotation.bundle;version=latest,\
	org.osgi.annotation.versioning;version=latest,\
	org.osgi.namespace.service;version=latest,\
	org.osgi.namespace.extender;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.condition;version=latest,\
	org.osgi.util.converter;version=latest,\
	org.eclipse.emf.common;version=latest,\
	org.eclipse.emf.ecore;version=latest,\
	org.eclipse.emf.ecore.xmi;version=latest,\
	biz.aQute.bnd.annotation;version=latest,\
	org.osgi.namespace.implementation,\
	org.osgi.resource,\
	osgi.annotation,\
	org.eclipse.fennec.emf.osgi.api;version=snapshot,\
	org.eclipse.fennec.emf.osgi.model.info;version=snapshot

-testpath: ${junit}

Provide-Capability: emf.core;emf.core=osgi;version:Version="6.3.0";deprecated=true

# The legacy package org.gecko.emf.osgi is exported once per version GeckoEMF
# used for it, so bundles built against any GeckoEMF 3.x - 6.x API resolve here
# (see docs/gecko-migration-guide.md, "Supported GeckoEMF versions"):
#   4.1.0 - current version (adds the pre-6 configurator interfaces)
#   4.0.0 - GeckoEMF 6.x; needed by implementers of @ProviderType types ([4.0,4.1))
#   3.1.0 - GeckoEMF 4.5.x
#   3.0.0 - GeckoEMF 3.x, 4.0 - 4.4, 4.6, 5.x
# The API is binary compatible across all of them. The "~" suffix is bnd syntax
# for a repeated clause of the same package. -exportcontents is used instead of
# Export-Package so that the bundle content is still selected by default.
-exportcontents: \
	org.gecko.emf.osgi;version=4.1.0,\
	org.gecko.emf.osgi~;version=4.0.0,\
	org.gecko.emf.osgi~~;version=3.1.0,\
	org.gecko.emf.osgi~~~;version=3.0.0
